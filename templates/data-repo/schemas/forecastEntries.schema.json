{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deals.forecast-entry.v1",
  "title": "Deals forecastEntries",
  "$comment": "Generated from the Zod schemas of Deals (app/v3/src/domain) by `bun run schema:export`. Do not edit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "deals.forecast-entry.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{4}-[0-9]{4}$"
        },
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000000,
          "description": "The amount without VAT, in haléře."
        },
        "companyId": {
          "type": "string",
          "pattern": "^C-[0-9]{4,6}$"
        },
        "ownerId": {
          "type": "string",
          "pattern": "^S-[0-9]{4,6}$"
        },
        "dealTypeId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "billingEntityId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "dealId": {
          "type": "string",
          "pattern": "^D-[0-9]{4}-[0-9]{4}$"
        },
        "reverseCharge": {
          "type": "boolean"
        },
        "invoicedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date"
        },
        "dueOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date"
        },
        "paidOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "description": "A new random value on every write; audit metadata, not business data.",
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "description": "When the App last wrote the record (UTC); audit metadata, not business data.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        "updatedBy": {
          "description": "The subject of the person the App last wrote the record for; audit metadata.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "month",
        "title",
        "amount"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "record"
  ],
  "additionalProperties": false
}
