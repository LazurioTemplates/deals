{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deals.deal.v1",
  "title": "Deals deals",
  "$comment": "Generated from the Zod schemas of Deals (app/v3/src/domain) by `bun run schema:export`. Do not edit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "deals.deal.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D-[0-9]{4}-[0-9]{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "companyId": {
          "type": "string",
          "pattern": "^C-[0-9]{4,6}$"
        },
        "contactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P-[0-9]{4,6}$"
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "stageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000000,
          "description": "An amount in minor units of the currency (haléře): 139000 = 1 390,00 Kč."
        },
        "probability": {
          "description": "The chance the deal is won when it differs from its stage's probability.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "description": "The day the deal entered the pipeline; the sales cycle starts here."
        },
        "expectedClose": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "closedAt": {
          "description": "The day the deal was won or lost; required in a won or lost stage, never open.",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "lossReasonId": {
          "description": "Why it was lost; required in the lost stage, else none.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "lossNote": {
          "type": "string",
          "minLength": 1
        },
        "quoteRef": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "description": "A new random value on every write; audit metadata, not business data.",
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "description": "When the App last wrote the record (UTC); audit metadata, not business data.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "updatedBy": {
          "description": "The subject of the person the App last wrote the record for; audit metadata.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "companyId",
        "owner",
        "stageId",
        "value",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "record"
  ],
  "additionalProperties": false
}
