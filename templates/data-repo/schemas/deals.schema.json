{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deals.deal.v2",
  "title": "Deals deals",
  "$comment": "Generated from the Zod schemas of Deals (app/v3/src/domain) by `bun run schema:export`. Do not edit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "deals.deal.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D-[0-9]{4}-[0-9]{4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "companyId": {
          "type": "string",
          "pattern": "^C-[0-9]{4,6}$"
        },
        "contactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P-[0-9]{4,6}$"
          }
        },
        "ownerId": {
          "type": "string",
          "pattern": "^S-[0-9]{4,6}$",
          "description": "The salesperson who owns the deal („Obchodník“)."
        },
        "stageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "dealTypeId": {
          "description": "The type of the deal („Typ zakázky“) from the settings.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "billingEntityId": {
          "description": "The entity that invoices it, from the settings; else the first one.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000000,
          "description": "The value without VAT in haléře; while the deal has a quote, its primary quote's total."
        },
        "probability": {
          "description": "The chance the deal is won when it differs from its stage's probability.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date",
          "description": "The day the deal entered the pipeline; the sales cycle starts here."
        },
        "expectedClose": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date"
        },
        "closedAt": {
          "description": "The day the deal was won or lost; required in a won or lost stage, never open.",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date"
        },
        "lossReasonId": {
          "description": "Why it was lost; required in the lost stage, else none.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "lossNote": {
          "type": "string",
          "minLength": 1
        },
        "primaryQuoteId": {
          "description": "The quote the value follows; else the approved one, else the latest revision.",
          "type": "string"
        },
        "paymentPlan": {
          "description": "How a won deal is invoiced month by month; only a won deal has one.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "planned",
                "unassigned"
              ]
            },
            "reverseCharge": {
              "description": "Whether the customer accounts for the VAT („Přenesená daňová povinnost“).",
              "type": "boolean"
            },
            "payments": {
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "description": "A short id unique within the plan: `p1`, `p2`."
                  },
                  "month": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                    "description": "The month the payment is invoiced („Fakturační měsíc“)."
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000000000,
                    "description": "The amount without VAT, in haléře."
                  },
                  "label": {
                    "description": "What it is: „Záloha“, „Doplatek“.",
                    "type": "string",
                    "minLength": 1
                  },
                  "invoicedOn": {
                    "description": "The day the invoice was issued.",
                    "type": "string",
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
                    "format": "date"
                  },
                  "dueOn": {
                    "description": "The day the invoice is due.",
                    "type": "string",
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
                    "format": "date"
                  },
                  "paidOn": {
                    "description": "The day it was paid.",
                    "type": "string",
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
                    "format": "date"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "month",
                  "amount"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "payments"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "description": "A new random value on every write; audit metadata, not business data.",
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "description": "When the App last wrote the record (UTC); audit metadata, not business data.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        "updatedBy": {
          "description": "The subject of the person the App last wrote the record for; audit metadata.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "companyId",
        "ownerId",
        "stageId",
        "value",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "record"
  ],
  "additionalProperties": false
}
