{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deals.activity.v1",
  "title": "Deals activities",
  "$comment": "Generated from the Zod schemas of Deals (app/v3/src/domain) by `bun run schema:export`. Do not edit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "deals.activity.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A-[0-9]{4}-[0-9]{5}$"
        },
        "dealId": {
          "type": "string",
          "pattern": "^D-[0-9]{4}-[0-9]{4}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "call",
            "meeting",
            "email",
            "note",
            "task"
          ]
        },
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9](\\.[0-9]{1,3})?)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "contactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P-[0-9]{4,6}$"
          }
        },
        "done": {
          "description": "Whether a task is done; only a task has it.",
          "type": "boolean"
        },
        "revision": {
          "description": "A new random value on every write; audit metadata, not business data.",
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "description": "When the App last wrote the record (UTC); audit metadata, not business data.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "updatedBy": {
          "description": "The subject of the person the App last wrote the record for; audit metadata.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "dealId",
        "type",
        "at",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "record"
  ],
  "additionalProperties": false
}
