{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deals.quote.v1",
  "title": "Deals quotes",
  "$comment": "Generated from the Zod schemas of Deals (app/v3/src/domain) by `bun run schema:export`. Do not edit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "deals.quote.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q-[0-9]{4}-[0-9]{4}-r[0-9]{1,3}$"
        },
        "number": {
          "type": "string",
          "pattern": "^Q-[0-9]{4}-[0-9]{4}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999,
          "description": "The revision of the quote („Revize“): 1, 2, 3."
        },
        "dealId": {
          "type": "string",
          "pattern": "^D-[0-9]{4}-[0-9]{4}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "approved",
            "superseded",
            "cancelled"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "issuedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date",
          "description": "The day the quote was written („Vystaveno“)."
        },
        "validUntil": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "billingEntityId": {
          "description": "The entity offering it, from the settings.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "customer": {
          "type": "object",
          "properties": {
            "companyId": {
              "type": "string",
              "pattern": "^C-[0-9]{4,6}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "ico": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            },
            "dic": {
              "type": "string",
              "minLength": 1
            },
            "address": {
              "type": "object",
              "properties": {
                "street": {
                  "type": "string",
                  "minLength": 1
                },
                "city": {
                  "type": "string",
                  "minLength": 1
                },
                "postalCode": {
                  "type": "string",
                  "minLength": 1
                },
                "country": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "contactId": {
          "type": "string",
          "pattern": "^P-[0-9]{4,6}$"
        },
        "vatRate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "A share in basis points: 2100 = 21 %."
        },
        "reverseCharge": {
          "type": "boolean"
        },
        "sections": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "description": "A short id unique within the quote: `l1`, `l2`."
              },
              "sectionId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "pricebookItemId": {
                "description": "The price list item it came from.",
                "type": "string",
                "pattern": "^I-[0-9]{4,6}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000000,
                "description": "A quantity with at most three decimals: 1.5"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "unitPrice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000000000,
                "description": "The price of one unit without VAT, in haléře."
              },
              "discount": {
                "description": "A discount of the line in basis points: 1000 = 10 %.",
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "id",
              "sectionId",
              "name",
              "quantity",
              "unit",
              "unitPrice"
            ],
            "additionalProperties": false
          }
        },
        "changeReserve": {
          "description": "A reserve for changes outside the price („Rezerva na změny“), in haléře.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000000
        },
        "terms": {
          "type": "object",
          "properties": {
            "vatNote": {
              "description": "The note on VAT („Poznámka k DPH“).",
              "type": "string",
              "minLength": 1
            },
            "payments": {
              "description": "Payments and deposits („Platby a zálohy“).",
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "description": "Scope, assumptions and other conditions.",
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "commercialTerms": {
          "type": "object",
          "properties": {
            "customerScope": {
              "type": "string",
              "enum": [
                "b2b",
                "b2c",
                "mixed",
                "unresolved"
              ]
            },
            "termsVersion": {
              "type": "string",
              "minLength": 1
            },
            "termsUrl": {
              "type": "string",
              "minLength": 1
            },
            "acceptedOn": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
              "format": "date"
            },
            "evidence": {
              "description": "Where the acceptance can be found: a signed quote, an e-mail.",
              "type": "string",
              "minLength": 1
            },
            "choices": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "payments",
                  "deposit",
                  "ownership",
                  "warranty",
                  "liability",
                  "service",
                  "support",
                  "sla",
                  "changes"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "standard",
                  "custom",
                  "customer",
                  "not-applicable",
                  "excluded",
                  "pending"
                ]
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "customerScope"
          ],
          "additionalProperties": false
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "sentOn": {
          "description": "The day it became active (was sent).",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date"
        },
        "approvedOn": {
          "description": "The day the customer approved it.",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "format": "date"
        },
        "revision": {
          "description": "A new random value on every write; audit metadata, not business data.",
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "description": "When the App last wrote the record (UTC); audit metadata, not business data.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "format": "date-time"
        },
        "updatedBy": {
          "description": "The subject of the person the App last wrote the record for; audit metadata.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "number",
        "version",
        "dealId",
        "status",
        "title",
        "issuedOn",
        "currency",
        "customer",
        "vatRate",
        "sections",
        "lines"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "record"
  ],
  "additionalProperties": false
}
