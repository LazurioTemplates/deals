{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deals.settings.v1",
  "title": "Deals settings",
  "$comment": "Generated from the Zod schemas of Deals (app/v3/src/domain) by `bun run schema:export`. Do not edit.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "deals.settings.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "The currency of every amount, ISO 4217; CZK by default."
        },
        "stages": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "open",
                  "won",
                  "lost"
                ]
              },
              "probability": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "A probability in whole percent."
              }
            },
            "required": [
              "id",
              "label",
              "kind",
              "probability"
            ],
            "additionalProperties": false
          },
          "description": "The pipeline in order: at least one open stage, exactly one won (100) and one lost (0)."
        },
        "lossReasons": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "owners": {
          "description": "The salespeople a deal is usually assigned to; another name only warns.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "aresLookup": {
          "type": "boolean",
          "description": "Whether the App looks companies up in ARES by their IČO."
        },
        "revision": {
          "description": "A new random value on every write; audit metadata, not business data.",
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "description": "When the App last wrote the record (UTC); audit metadata, not business data.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "updatedBy": {
          "description": "The subject of the person the App last wrote the record for; audit metadata.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "currency",
        "stages",
        "lossReasons",
        "aresLookup"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "record"
  ],
  "additionalProperties": false
}
